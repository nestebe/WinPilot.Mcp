{
  "tools": [
    {
      "name": "windows_batch",
      "inputSchema": {
        "type": "object",
        "properties": {
          "actions": {
            "description": "List of actions to execute in order.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string"
                },
                "ref": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "default": null
                },
                "text": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "default": null
                },
                "value": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "default": null
                },
                "ms": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "default": null
                },
                "handle": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "default": null
                },
                "chord": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "default": null
                },
                "keys": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "string"
                  },
                  "default": null
                }
              },
              "required": [
                "action"
              ]
            }
          },
          "stopOnError": {
            "description": "Stop executing when an action fails (default true).",
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "actions"
        ]
      }
    },
    {
      "name": "windows_click",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ref": {
            "description": "Element ref from windows_snapshot (e.g. \u0027w1e5\u0027).",
            "type": "string"
          },
          "button": {
            "description": "Mouse button: left (default), right, middle. Right and middle always use a real mouse click.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "doubleClick": {
            "description": "Double-click instead of a single click (default false).",
            "type": [
              "boolean",
              "null"
            ],
            "default": null
          }
        },
        "required": [
          "ref"
        ]
      }
    },
    {
      "name": "windows_close",
      "inputSchema": {
        "type": "object",
        "properties": {
          "handle": {
            "description": "Window handle to close.",
            "type": "string"
          },
          "force": {
            "description": "Kill the app process when it was launched by this server and the graceful close times out.",
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "handle"
        ]
      }
    },
    {
      "name": "windows_fill",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ref": {
            "description": "Element ref from windows_snapshot (e.g. \u0027w1e5\u0027).",
            "type": "string"
          },
          "value": {
            "description": "Value to fill.",
            "type": "string"
          }
        },
        "required": [
          "ref",
          "value"
        ]
      }
    },
    {
      "name": "windows_focus",
      "inputSchema": {
        "type": "object",
        "properties": {
          "handle": {
            "description": "Window handle from windows_list_windows or windows_launch.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "title": {
            "description": "Window title substring (alternative to handle).",
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        }
      }
    },
    {
      "name": "windows_get_text",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ref": {
            "description": "Element ref from windows_snapshot (e.g. \u0027w1e5\u0027).",
            "type": "string"
          }
        },
        "required": [
          "ref"
        ]
      }
    },
    {
      "name": "windows_launch",
      "inputSchema": {
        "type": "object",
        "properties": {
          "app": {
            "description": "Executable path or UWP app id, e.g. \u0027calc.exe\u0027 or \u0027Microsoft.WindowsCalculator_8wekyb3d8bbwe!App\u0027.",
            "type": "string"
          },
          "args": {
            "description": "Optional command line arguments.",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "string",
                "null"
              ]
            },
            "default": null
          },
          "timeoutMs": {
            "description": "Optional timeout in milliseconds to wait for the app window (default 10000).",
            "type": [
              "integer",
              "null"
            ],
            "default": null
          }
        },
        "required": [
          "app"
        ]
      }
    },
    {
      "name": "windows_list_windows",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "windows_screenshot",
      "inputSchema": {
        "type": "object",
        "properties": {
          "handle": {
            "description": "Window handle. If omitted, captures the foreground window.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "ref": {
            "description": "Element ref to capture. If omitted, captures the whole window.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "fullScreen": {
            "description": "Capture the entire screen (default false).",
            "type": [
              "boolean",
              "null"
            ],
            "default": null
          },
          "background": {
            "description": "Use native background window capture for a window handle, falling back to a normal capture if unavailable (default false).",
            "type": [
              "boolean",
              "null"
            ],
            "default": null
          },
          "savePath": {
            "description": "Absolute local .png file path to save the screenshot to.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "overwrite": {
            "description": "Allow savePath to replace an existing file (default false).",
            "type": [
              "boolean",
              "null"
            ],
            "default": null
          }
        }
      }
    },
    {
      "name": "windows_send_keys",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ref": {
            "description": "Element ref from windows_snapshot. If omitted, sends to the focused element.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "chord": {
            "description": "Single key chord, e.g. \u0027Ctrl\u002BRight\u0027 or \u0027Alt\u002BF4\u0027.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "keys": {
            "description": "Sequence of key presses/chords, e.g. [\u0027Ctrl\u002BC\u0027, \u0027Ctrl\u002BV\u0027, \u0027Enter\u0027].",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "string",
                "null"
              ]
            },
            "default": null
          }
        }
      }
    },
    {
      "name": "windows_snapshot",
      "inputSchema": {
        "type": "object",
        "properties": {
          "handle": {
            "description": "Window handle from windows_launch or windows_list_windows. If omitted, uses the foreground window.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "maxDepth": {
            "description": "Optional maximum tree depth (1-20, default 10). Deeper subtrees are replaced by truncation markers.",
            "type": [
              "integer",
              "null"
            ],
            "default": null
          }
        }
      }
    },
    {
      "name": "windows_type",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "description": "Text to type.",
            "type": "string"
          },
          "ref": {
            "description": "Element ref from windows_snapshot. If omitted, types into the currently focused element.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "submit": {
            "description": "Press Enter after typing (default false).",
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "windows_wait_for",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ref": {
            "description": "Element ref from windows_snapshot to wait for (alternative to a selector).",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "handle": {
            "description": "Window handle to search in. If omitted, uses the ref\u0027s window or the foreground window.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "name": {
            "description": "Accessible name to wait for (exact match).",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "automationId": {
            "description": "Automation id to wait for (exact match).",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "controlType": {
            "description": "Control type to wait for (e.g. Button, Edit, ListItem).",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "timeoutMs": {
            "description": "Timeout in milliseconds (default 10000).",
            "type": [
              "integer",
              "null"
            ],
            "default": null
          }
        }
      }
    }
  ]
}
