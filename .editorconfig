root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning
# The server is an English-only CLI tool: literals are intentional, not localizable.
dotnet_diagnostic.CA1303.severity = none
# WinPilot exceptions always carry a typed error code; code-less constructors are meaningless.
dotnet_diagnostic.CA1032.severity = none
# Low-volume logging: source-generated LoggerMessage delegates are not required.
dotnet_diagnostic.CA1848.severity = suggestion
# Low-volume logging: deferring argument evaluation is not required.
dotnet_diagnostic.CA1873.severity = suggestion
# ConfigureAwait(false) is not mandatory for this app/library pairing.
dotnet_diagnostic.CA2007.severity = suggestion

[*.{json,yml,yaml,csproj,props,targets,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Test projects: underscored test names are the readable convention; test classes are intentionally public.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1515.severity = none
