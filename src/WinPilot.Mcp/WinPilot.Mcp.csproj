<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>winpilot-mcp</AssemblyName>
    <RootNamespace>WinPilot.Mcp</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>winpilot-mcp</ToolCommandName>
    <PackageId>WinPilot.Mcp</PackageId>
    <Description>MCP server for Windows desktop automation (UI Automation / FlaUI)</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinPilot.Automation\WinPilot.Automation.csproj" />
  </ItemGroup>

  <!--
    The .NET SDK's PackAsTool validation rejects OS-specific target frameworks (net10.0-windows):
    https://github.com/dotnet/sdk/issues/52716. Until the SDK supports it, clear the platform
    moniker for the validation so the package is produced with the tools/net10.0/any layout
    that 'dotnet tool install' expects.
  -->
  <Target Name="ClearPlatformMonikerForToolPack"
          BeforeTargets="_PackToolValidation"
          Condition="'$(PackAsTool)' == 'true'">
    <PropertyGroup>
      <TargetPlatformIdentifier />
      <TargetPlatformMoniker />
    </PropertyGroup>
  </Target>
</Project>
